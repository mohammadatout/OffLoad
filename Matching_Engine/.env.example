# OffLoad Matching Engine — environment template.
# Copy to .env and fill in locally. NEVER commit the real .env.

# --- Database -------------------------------------------------------------
# SQLite file for the match library. Defaults to offload.db beside this file.
OFFLOAD_DB_PATH=offload.db

# --- Sessions -------------------------------------------------------------
# Session lifetime in hours.
OFFLOAD_SESSION_HOURS=8

# Set to 1 only when the app is served over HTTPS, so the session cookie
# carries the Secure flag.
OFFLOAD_COOKIE_SECURE=0

# --- Uploads --------------------------------------------------------------
# Maximum upload size in bytes (default 512 MB). The Cisco reference export is
# streamed to the database, so a large value here does not mean large memory use.
OFFLOAD_MAX_UPLOAD_BYTES=536870912

# --- Service --------------------------------------------------------------
# Port 8000 is often already taken by other local tooling, so the default is
# 8010. If you change this, set MATCHER_API_ORIGIN for the Next.js app to match.
OFFLOAD_MATCHER_PORT=8010

# --- First admin account --------------------------------------------------
# Read only by seed_admin.py, never by the service. Unset them afterwards.
# Use a strong password of at least 8 characters.
OFFLOAD_ADMIN_USER=
OFFLOAD_ADMIN_PASSWORD=
